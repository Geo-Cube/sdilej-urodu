{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "prisma/**/*.ts",
    "prisma.config.ts",
    "vitest.config.ts",
    "test/**/*"
  ],
  "exclude": [
    "src/generated"
  ]
}
